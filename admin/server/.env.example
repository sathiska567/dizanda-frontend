# Copy this file to .env and adjust values before running the admin server

# Port the admin API listens on
PORT=5000

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Secret used to sign admin JWTs — change this to a long random string
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=12h

# Seed credentials for the first admin account.
# Only used the first time the server starts and no admin user exists yet.
ADMIN_NAME=Dizanda Admin
ADMIN_EMAIL=admin@dizanda.com
ADMIN_PASSWORD=ChangeMe123!

# Public base URL used to build absolute links for uploaded images
PUBLIC_URL=http://localhost:5000
